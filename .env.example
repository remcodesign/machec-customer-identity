APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION="pgsql"
DB_HOST="db"
DB_PORT="5432"
DB_DATABASE="db"
DB_USERNAME="db"
DB_PASSWORD="db"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fixed address that always receives a password-reset notification (D79,
# Step 2.7) — read via config('mail.admin_address'), never a `users` lookup,
# since there is no self-service reset broker yet. Point this at a real
# inbox once the app is deployed.
MAIL_ADMIN_ADDRESS="admin@example.com"

# Fixed password for the seeded customer_admin demo account (DatabaseSeeder,
# D87/D89) — a shared secret known only to whoever has this app's real .env,
# so the same account can be logged into locally (ddev) and on a deployed
# environment without a random per-run password. Set a stronger value than
# this example default in any environment that isn't purely local.
ADMIN_PASSWORD=xxxxxxx

# Sanctum SPA cookie auth (D8, corrected by D115) — domains that receive a
# stateful session cookie instead of needing a bearer token. There is no
# shared parent domain: the BFF is the only party that ever presents this
# check (browser <-> BFF stays same-origin; the BFF relays the session
# cookie server-side to Commercial Core/Identity). `localhost:3000` below
# covers the BFF's local `next dev` origin. In production this whole value
# MUST be set as a Laravel Cloud secret to the BFF's real Cloud Run host
# (bare host[:port], no scheme — see config/sanctum.php) — env() replaces
# this default entirely rather than merging with it, so an unset secret
# silently falls back to local-only origins and rejects every real BFF
# login/register call with no obvious error. No fixed literal is given
# here since Cloud Run assigns the host at deploy time unless a custom
# domain is mapped.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# The other two co-located admin apps' base URLs (D20) — <x-machec::admin-nav>'s
# switcher links point a plain <a href> at each app's own /login page. Defaults
# match this workspace's own ddev project names; override in production once
# each app's real Laravel Cloud domain is known.
COMMERCIAL_CORE_URL=https://machec-commercial-core.ddev.site
LOGISTICS_WMS_URL=https://machec-logistics-wms.ddev.site

# Whether a password-reset request (D79, Step 2.7) also emails the
# requesting customer a plain acknowledgement, on top of the admin
# notification that always goes out. No token/link, since there is no
# self-service reset flow yet.
NOTIFY_CUSTOMER_ON_PASSWORD_REQUEST=false

